#!/usr/bin/env bash
# Portable stand-in for the two GNU date formats deploy.sh uses (macOS date lacks %N).
case "$*" in
*%s%3N*) perl -MTime::HiRes=time -e 'printf "%d\n", time() * 1000' ;;
*) perl -MTime::HiRes=time -MPOSIX=strftime -e \
  '$t = time; printf "%s.%03dZ\n", strftime("%Y-%m-%dT%H:%M:%S", gmtime($t)), ($t - int($t)) * 1000' ;;
esac
